{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": ["chrome", "vite/client"],
    "baseUrl": ".",
    "paths": {
      "@navex/sdk": ["./src/index.ts"]
    }
  },
  "include": ["src", "vite.config.ts", "vite.content.config.ts", "scripts"]
}