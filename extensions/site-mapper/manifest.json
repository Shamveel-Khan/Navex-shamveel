{
  "manifest_version": 3,
  "name": "NAVEX Site Mapper",
  "version": "0.1.0",
  "description": "Automatically scans the current website, generates a structured NAVEX page/UI map, and injects data-waid attributes so the NAVEX agent can operate the site.",
  "permissions": ["storage", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "NAVEX Site Mapper",
    "default_icon": "icon.svg"
  },
  "icons": {
    "128": "icon.svg"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}